# Copy to config/server.env with scripts/configure.sh. Never commit the result.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
MODEL_SIZE=1.7b
# Named profiles override these tuning defaults when supplied to start-server.sh.
CONTEXT_SIZE=4096
THREADS=4
THREADS_BATCH=4
BATCH_SIZE=512
UBATCH_SIZE=128
PARALLEL=1
FLASH_ATTN=auto
CACHE_TYPE_K=f16
CACHE_TYPE_V=f16
ENABLE_METRICS=1
ENABLE_PERF=1
HEALTHCHECK_TIMEOUT=10
WATCHDOG_INTERVAL=60
WATCHDOG_FAILURE_THRESHOLD=3
API_KEY=replace-me
# Alternatively, leave API_KEY empty and point to an existing mode-600 file.
API_KEY_FILE=
